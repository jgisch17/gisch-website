---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Message Sent | GISCH" description="Thanks for reaching out to GISCH, a Commerce Consultancy.">
  <div class="min-h-screen bg-navy flex flex-col items-center justify-center text-center px-6">

    <!-- Top gold accent line -->
    <div class="absolute top-0 left-0 right-0 h-px"
      style="background: linear-gradient(to right, transparent, #B89A3E, transparent);">
    </div>

    <div class="max-w-xl">
      <!-- Logo -->
      <div class="flex justify-center mb-10">
        <img src="/logos/gcc-long.png" alt="GISCH" class="h-16 w-auto" />
      </div>

      <!-- Gold divider -->
      <div class="w-12 h-0.5 bg-gold mx-auto mb-8"></div>

      <h1 class="font-display text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
        Message Received.
      </h1>
      <p class="text-white/50 text-lg leading-relaxed mb-10">
        Thanks for reaching out. We review every inquiry personally and will be in touch within 1–2 business days.
      </p>

      <a
        href="/"
        class="inline-block bg-gold hover:bg-gold-light text-navy font-semibold px-10 py-4 rounded-sm text-xs tracking-[0.2em] uppercase transition-all duration-200 hover:shadow-lg hover:shadow-gold/20"
      >
        Back to Home
      </a>
    </div>

  </div>
</Layout>
