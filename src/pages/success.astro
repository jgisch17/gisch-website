---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Message Sent | GISCH" description="Thanks for reaching out to GISCH, a commerce consultancy.">
  <div class="min-h-screen bg-ink flex flex-col items-center justify-center text-center px-6">
    <div class="max-w-xl">
      <div class="flex justify-center mb-10">
        <img src="/logos/gisch-horizontal_reversed.svg" alt="GISCH, a commerce consultancy" class="h-24 md:h-28 w-auto" width="464" height="168" />
      </div>

      <h1 class="font-display text-4xl md:text-5xl text-paper mb-6 leading-tight">
        Message Received.
      </h1>
      <p class="text-paper/60 text-lg leading-relaxed mb-10">
        Thanks for reaching out. I read every message myself and will reply within 1 to 2 business days.
      </p>

      <a
        href="/"
        class="inline-block bg-orange hover:bg-[#FF8550] text-ink font-semibold px-10 py-4 rounded-md text-xs tracking-[0.2em] uppercase transition-colors duration-200"
      >
        Back to Home
      </a>
    </div>
  </div>
</Layout>
