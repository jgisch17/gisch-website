---
const year = new Date().getFullYear();
---
<footer class="bg-ink py-14 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="flex flex-col md:flex-row items-center justify-between gap-8 mb-10 pb-10 border-b border-paper/10">
      <a href="/" class="flex items-center">
        <img src="/logos/gisch-horizontal-notag_reversed.svg" alt="GISCH, a commerce consultancy" class="h-14 w-auto -ml-3 opacity-90 hover:opacity-100 transition-opacity" />
      </a>

      <nav class="flex items-center gap-8">
        <a href="#about" class="text-paper/50 hover:text-paper text-xs tracking-widest uppercase transition-colors duration-200">About</a>
        <a href="#services" class="text-paper/50 hover:text-paper text-xs tracking-widest uppercase transition-colors duration-200">Services</a>
        <a href="#contact" class="text-paper/50 hover:text-paper text-xs tracking-widest uppercase transition-colors duration-200">Contact</a>
        <a href="https://www.linkedin.com/in/jordangisch/" target="_blank" rel="noopener noreferrer" class="text-paper/50 hover:text-paper text-xs tracking-widest uppercase transition-colors duration-200">LinkedIn</a>
      </nav>
    </div>

    <div class="flex flex-col md:flex-row items-center justify-between gap-4">
      <p class="text-paper/40 text-xs tracking-wide">
        &copy; {year} GISCH, a commerce consultancy. All rights reserved.
      </p>
      <p class="text-paper/30 text-xs tracking-widest uppercase">
        gischcommerce.com
      </p>
    </div>

  </div>
</footer>
