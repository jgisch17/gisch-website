---
---
<section class="relative min-h-screen bg-ink flex flex-col items-center justify-center text-center px-6 pb-24 overflow-hidden">

  <!-- Soft light, top right (warm San Diego light, kept quiet) -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute -top-40 right-0 w-[700px] h-[700px] rounded-full opacity-[0.07]"
      style="background: radial-gradient(circle, #F6F5F1 0%, transparent 65%);">
    </div>
  </div>

  <div class="relative z-10 max-w-4xl mx-auto pt-28">
    <!-- Logo -->
    <div class="flex justify-center mb-10">
      <img src="/logos/gisch-horizontal_reversed.svg" alt="GISCH, a commerce consultancy" class="h-28 md:h-44 w-auto" width="464" height="168" />
    </div>

    <!-- Eyebrow -->
    <p class="text-paper/50 text-xs font-semibold tracking-[0.3em] uppercase mb-6">
      Amazon Ads &amp; Commerce Media Consulting
    </p>

    <!-- Headline -->
    <h1 class="font-display text-[2.6rem] sm:text-5xl md:text-6xl lg:text-7xl text-paper leading-[1.05] mb-8">
      Where Brands Go<br />
      <span class="text-orange">to Win.</span>
    </h1>

    <!-- Subheadline -->
    <p class="text-paper/60 text-lg md:text-xl max-w-2xl mx-auto mb-12 leading-relaxed">
      I help a handful of brands grow on Amazon and every retail network after it. 12+ years in, and I'm on every call.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#contact"
        class="bg-orange hover:bg-[#FF8550] text-ink font-semibold px-10 py-4 rounded-md text-xs tracking-[0.2em] uppercase transition-colors duration-200"
      >
        See If We're a Fit
      </a>
      <a
        href="#services"
        class="border border-paper/25 hover:border-paper/60 text-paper/80 hover:text-paper font-semibold px-10 py-4 rounded-md text-xs tracking-[0.2em] uppercase transition-colors duration-200"
      >
        Services
      </a>
    </div>
  </div>


  <!-- Diagonal section transition to Paper -->
  <div class="absolute bottom-0 left-0 right-0 leading-none">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block;width:100%;height:80px;">
      <path d="M0,80 L1440,0 L1440,80 Z" fill="#F6F5F1" />
    </svg>
  </div>
</section>
