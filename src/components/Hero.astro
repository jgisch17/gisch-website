---
---
<section class="relative min-h-screen bg-navy flex flex-col items-center justify-center text-center px-6 pb-24 overflow-hidden">

  <!-- Radial glow -->
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] rounded-full opacity-10"
      style="background: radial-gradient(circle, #B89A3E 0%, transparent 70%);">
    </div>
  </div>

  <!-- Top gold accent line -->
  <div class="absolute top-0 left-0 right-0 h-px"
    style="background: linear-gradient(to right, transparent, #B89A3E, transparent);">
  </div>

  <div class="relative z-10 max-w-4xl mx-auto pt-28">
    <!-- Logo mark -->
    <div class="flex justify-center mb-12">
      <img src="/logos/gcc-long.png" alt="GISCH A Commerce Consultancy" class="h-24 md:h-36 w-auto opacity-95" />
    </div>

    <!-- Eyebrow -->
    <p class="text-gold text-xs font-semibold tracking-[0.3em] uppercase mb-6">
      Amazon Ads &amp; AMC Consulting
    </p>

    <!-- Headline -->
    <h1 class="font-display text-4xl md:text-6xl lg:text-7xl font-bold text-white leading-[1.1] mb-8">
      Where Brands Go<br />
      <span style="background: linear-gradient(135deg, #D4B56A 0%, #B89A3E 50%, #8A7030 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
        to Win.
      </span>
    </h1>

    <!-- Subheadline -->
    <p class="text-white/50 text-lg md:text-xl font-light max-w-2xl mx-auto mb-12 leading-relaxed">
      Expert Amazon advertising strategy and commerce media management — built for brands that demand senior-level attention and results that actually move the needle.
    </p>

    <!-- CTAs -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center">
      <a
        href="#contact"
        class="bg-gold hover:bg-gold-light text-navy font-semibold px-10 py-4 rounded-sm text-xs tracking-[0.2em] uppercase transition-all duration-200 hover:shadow-xl hover:shadow-gold/20"
      >
        Let's Talk Strategy
      </a>
      <a
        href="#services"
        class="border border-white/20 hover:border-gold/60 text-white/70 hover:text-gold font-medium px-10 py-4 rounded-sm text-xs tracking-[0.2em] uppercase transition-all duration-200"
      >
        Our Services
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute bottom-24 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2">
    <span class="text-white/20 text-[10px] tracking-[0.3em] uppercase">Scroll</span>
    <div class="w-px h-10" style="background: linear-gradient(to bottom, rgba(255,255,255,0.2), transparent);"></div>
  </div>

  <!-- Diagonal section transition to white -->
  <div class="absolute bottom-0 left-0 right-0 leading-none">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block;width:100%;height:80px;">
      <path d="M0,80 L1440,0 L1440,80 Z" fill="white" />
    </svg>
  </div>
</section>
