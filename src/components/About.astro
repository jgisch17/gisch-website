---
---
<section id="about" class="relative bg-paper py-16 md:py-28 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">

      <!-- Left: Narrative -->
      <div>
        <p class="text-slate text-xs font-semibold tracking-[0.3em] uppercase mb-5">About</p>
        <h2 class="font-display text-4xl md:text-5xl text-ink leading-tight mb-6">
          12+ Years In.<br />Still Building.
        </h2>
        <div class="w-12 h-0.5 bg-ink mb-8"></div>

        <p class="text-slate text-lg leading-relaxed mb-5">
          I'm Jordan Gisch. I've spent 12+ years in commerce media and Amazon advertising, starting at CPC Strategy and Tinuiti. Over that time I've managed or overseen hundreds of millions of dollars in media across Amazon, Walmart, Target, Instacart and more.
        </p>
        <p class="text-slate text-lg leading-relaxed mb-5">
          I started Gisch for brands that need senior help and are too small to get it from a big agency. The person who sells the deal does the work.
        </p>
        <p class="text-slate text-lg leading-relaxed">
          I work with a handful of handpicked brands. I lead every engagement, I'm on every call, and clients get my phone number.
        </p>

        <div class="mt-10 flex flex-wrap gap-3">
          {['Amazon', 'Walmart Connect', 'Target Roundel', 'Instacart', 'CitrusAd', 'Amazon AMC', 'Criteo', 'Chewy'].map((platform) => (
            <span class="bg-white border border-border text-ink text-xs font-semibold px-4 py-2 rounded-md tracking-wide">
              {platform}
            </span>
          ))}
        </div>
      </div>

      <!-- Right: Credential Cards -->
      <div class="space-y-5">
        <div class="bg-ink rounded-lg p-8">
          <div class="font-display text-5xl font-extrabold tracking-tight text-paper mb-2">12+</div>
          <div class="text-paper/60 text-sm tracking-wide">Years in commerce media &amp; Amazon advertising</div>
        </div>

        <div class="bg-white border border-border rounded-lg p-8">
          <div class="font-display text-4xl font-extrabold tracking-tight text-ink mb-2">Hundreds of Millions</div>
          <div class="text-slate text-sm tracking-wide">In media managed or overseen, directly or leading a team</div>
        </div>

        <div class="bg-white border border-border rounded-lg p-8">
          <div class="font-display text-2xl font-extrabold tracking-tight text-ink mb-2">Fortune 50 to Mom-and-Pop</div>
          <div class="text-slate text-sm tracking-wide">Mostly CPG: baby, pet, fashion &amp; apparel, and food</div>
        </div>

        <div class="bg-ink rounded-lg p-6 flex items-center gap-4">
          <div class="w-2 h-2 rounded-full bg-orange flex-shrink-0"></div>
          <p class="text-paper font-semibold text-sm">Amazon Accredited Advertiser</p>
        </div>
      </div>

    </div>
  </div>

  <!-- Diagonal transition to Ink Services section -->
  <div class="absolute bottom-0 left-0 right-0 leading-none">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block;width:100%;height:80px;">
      <path d="M0,0 L1440,80 L0,80 Z" fill="#0D1B2A" />
    </svg>
  </div>
</section>
