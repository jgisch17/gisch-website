<section id="services" class="relative bg-navy pt-20 md:pt-32 pb-24 md:pb-36 px-6">

  <div class="max-w-6xl mx-auto">

    <!-- Header -->
    <div class="text-center mb-12 md:mb-20">
      <p class="text-gold text-xs font-semibold tracking-[0.3em] uppercase mb-5">What We Do</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold text-white mb-6 leading-tight">
        Senior-Level Expertise.<br />Every Engagement.
      </h2>
      <p class="text-white/40 text-lg max-w-xl mx-auto leading-relaxed">
        We work with a select group of brands — so every client gets the full weight of our expertise, every time.
      </p>
    </div>

    <!-- Service Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-px bg-white/5 rounded-sm overflow-hidden">
      {services.map((service) => (
        <div class="bg-navy p-6 md:p-10 group hover:bg-navy-mid transition-colors duration-300 cursor-default">
          <div class="font-display text-5xl font-bold mb-6" style="color: rgba(184,154,62,0.15);">
            {service.number}
          </div>
          <h3 class="font-display text-xl font-semibold text-white mb-4 group-hover:text-gold transition-colors duration-200">
