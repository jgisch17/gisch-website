        class="inline-block border border-gold/40 hover:border-gold text-gold hover:text-gold-light text-xs font-semibold px-10 py-4 rounded-sm tracking-[0.2em] uppercase transition-all duration-200"
      >
        See If We're a Match
      </a>
    </div>

  </div>

  <!-- Diagonal transition to cream Contact section -->
  <div class="absolute bottom-0 left-0 right-0 leading-none">
    <svg viewBox="0 0 1440 80" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none" style="display:block;width:100%;height:80px;">
